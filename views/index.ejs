<%- include('partials/header') %>

<section class="hero-banner">
  <% if (featuredBoat) { %>
    <img class="hero-banner-image" src="/images/boats/<%= featuredBoat.cover_image %>" alt="<%= featuredBoat.name %>">
    <div class="hero-banner-caption">
      <span class="hero-banner-kicker">Featured Listing</span>
      <h1><%= featuredBoat.year %> <%= featuredBoat.name %></h1>
    </div>
  <% } %>

  <div class="hero-filter-card">
    <h2>Find Your Boat</h2>
    <form method="get" action="/">
      <label>
        Condition
        <select name="condition">
          <option value="">All</option>
          <option value="new" <%= selectedCondition === 'new' ? 'selected' : '' %>>New</option>
          <option value="used" <%= selectedCondition === 'used' ? 'selected' : '' %>>Used</option>
        </select>
      </label>
      <label>
        Make
        <select name="make">
          <option value="">All Makes</option>
          <% makes.forEach(function(m) { %>
            <option value="<%= m %>" <%= m === selectedMake ? 'selected' : '' %>><%= m %></option>
          <% }); %>
        </select>
      </label>
      <div class="hero-filter-row">
        <label>Price From <input type="number" name="priceMin" placeholder="<%= Math.floor(bounds.minPrice / 100) %>" min="0" step="1000" value="<%= priceMin %>"></label>
        <label>Price To <input type="number" name="priceMax" placeholder="<%= Math.ceil(bounds.maxPrice / 100) %>" min="0" step="1000" value="<%= priceMax %>"></label>
      </div>
      <div class="hero-filter-row">
        <label>Length From (ft) <input type="number" name="lengthMin" placeholder="<%= bounds.minLength %>" min="0" value="<%= lengthMin %>"></label>
        <label>Length To (ft) <input type="number" name="lengthMax" placeholder="<%= bounds.maxLength %>" min="0" value="<%= lengthMax %>"></label>
      </div>
      <button class="btn hero-filter-submit" type="submit">Search</button>

      <details class="advanced-search">
        <summary>Advanced Search</summary>
        <label>
          Type
          <select name="type">
            <option value="">All Types</option>
            <% types.forEach(function(t) { %>
              <option value="<%= t %>" <%= t === selectedType ? 'selected' : '' %>><%= t %></option>
            <% }); %>
          </select>
        </label>
        <div class="hero-filter-row">
          <label>Year From <input type="number" name="yearMin" placeholder="<%= bounds.minYear %>" min="<%= bounds.minYear %>" max="<%= bounds.maxYear %>" value="<%= yearMin %>"></label>
          <label>Year To <input type="number" name="yearMax" placeholder="<%= bounds.maxYear %>" min="<%= bounds.minYear %>" max="<%= bounds.maxYear %>" value="<%= yearMax %>"></label>
        </div>
        <label>Keyword <input type="text" name="q" placeholder="Name or manufacturer" value="<%= q %>"></label>
      </details>

      <% if (selectedType || selectedMake || selectedCondition || q || yearMin || yearMax || priceMin || priceMax || lengthMin || lengthMax) { %>
        <a class="clear-filters" href="/">Clear filters</a>
      <% } %>
    </form>
  </div>
</section>

<div class="hero-banner-strip">
  <span>Buy and sell boats with confidence — real listings, real sellers.</span>
  <a class="btn small" href="/sell/new">Sell your boat</a>
</div>

<div class="results-heading">
  <h2><%= boats.length %> Boat<%= boats.length === 1 ? '' : 's' %> For Sale</h2>
</div>

<% if (boats.length === 0) { %>
  <p class="empty-state">No boats match your search.</p>
<% } else { %>
  <div class="boat-grid">
    <% boats.forEach(function(boat) {
      var daysListed = Math.max(0, Math.floor((Date.now() - new Date(boat.created_at.replace(' ', 'T') + 'Z').getTime()) / 86400000));
    %>
      <div class="boat-card">
        <a class="boat-card-image" href="/boats/<%= boat.id %>">
          <img src="/images/boats/<%= boat.cover_image %>" alt="<%= boat.name %>">
          <% if (boat.status === 'sold') { %>
            <span class="badge badge-sold">Sold</span>
          <% } else if (boat.status === 'pending') { %>
            <span class="badge badge-pending">Sale Pending</span>
          <% } else if (boat.condition === 'new' && boat.stock <= 0) { %>
            <span class="badge badge-pending">Pending Sale</span>
          <% } else if (daysListed <= 3) { %>
            <span class="badge badge-new">New Listing</span>
          <% } %>
        </a>
        <div class="boat-card-body">
          <div class="price"><%= formatPrice(boat.price_cents) %></div>
          <h3><a href="/boats/<%= boat.id %>"><%= boat.name %></a></h3>
          <div class="spec-line">ID #<%= boat.id %> · <%= boat.type %> · <%= boat.length_ft %> ft · <%= boat.year %></div>
          <div class="meta-line">Listed <%= daysListed === 0 ? 'today' : daysListed + 'd ago' %> · <%= boat.views %> views</div>
          <% if (boat.status === 'available' && (boat.condition !== 'new' || boat.stock > 0) && !(currentUser && currentUser.id === boat.owner_id)) { %>
            <% if (currentUser) { %>
              <form method="post" action="/cart/add">
                <input type="hidden" name="boatId" value="<%= boat.id %>">
                <button class="btn small" type="submit">Add to cart</button>
              </form>
            <% } else { %>
              <a class="btn small secondary" href="/login?next=<%= encodeURIComponent('/') %>">Log in to add to cart</a>
            <% } %>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<section class="brand-strip">
  <h2>Featured Brands</h2>
  <div class="brand-pills">
    <% makes.forEach(function(m) { %>
      <a class="brand-pill" href="/?make=<%= encodeURIComponent(m) %>"><%= m %></a>
    <% }); %>
  </div>
</section>

<section class="link-columns">
  <div class="link-column">
    <h3>Popular Boat Types</h3>
    <% types.forEach(function(t) { %>
      <a href="/?type=<%= encodeURIComponent(t) %>"><%= t %>s</a>
    <% }); %>
  </div>
  <div class="link-column">
    <h3>Popular Manufacturers</h3>
    <% makes.slice(0, 10).forEach(function(m) { %>
      <a href="/?make=<%= encodeURIComponent(m) %>"><%= m %></a>
    <% }); %>
  </div>
  <div class="link-column">
    <h3>Shop By Condition</h3>
    <a href="/?condition=new">New Boats</a>
    <a href="/?condition=used">Used Boats</a>
  </div>
</section>

<%- include('partials/footer') %>
