<%- include('partials/header') %>

<h1><%= boat ? 'Edit Your Boat' : 'Sell a Boat' %></h1>
<% if (!boat) { %><p>List your boat for buyers to find. It'll show up in the catalog right away.</p><% } %>

<form class="stacked-form" method="post" action="<%= boat ? '/sell/' + boat.id + '/edit' : '/sell/new' %>">
  <label>
    Name
    <input type="text" name="name" value="<%= boat ? boat.name : '' %>" required>
  </label>

  <div class="form-row">
    <label>
      Type
      <input type="text" name="type" value="<%= boat ? boat.type : '' %>" required>
    </label>
    <label>
      Manufacturer
      <input type="text" name="manufacturer" value="<%= boat ? boat.manufacturer : '' %>" required>
    </label>
  </div>

  <div class="form-row">
    <label>
      Year
      <input type="number" name="year" value="<%= boat ? boat.year : '' %>" required>
    </label>
    <label>
      Length (ft)
      <input type="number" name="length_ft" value="<%= boat ? boat.length_ft : '' %>" required>
    </label>
    <label>
      Capacity
      <input type="number" name="capacity" value="<%= boat ? boat.capacity : '' %>" required>
    </label>
    <label>
      Engine Hours
      <input type="number" name="engine_hours" value="<%= boat ? boat.engine_hours : 0 %>" required>
    </label>
  </div>

  <div class="form-row">
    <label>
      Price (USD)
      <input type="number" step="0.01" name="price" value="<%= boat ? (boat.price_cents / 100).toFixed(2) : '' %>" required>
    </label>
    <label>
      Stock
      <input type="number" name="stock" value="<%= boat ? boat.stock : 1 %>" required>
    </label>
  </div>

  <div class="form-row">
    <label>
      City
      <input type="text" name="city" value="<%= boat ? boat.city : '' %>" required>
    </label>
    <label>
      Province
      <select name="province" required>
        <option value="" disabled <%= !boat || !boat.province ? 'selected' : '' %>>Select a province</option>
        <% provinces.forEach(function(p) { %>
          <option value="<%= p %>" <%= boat && boat.province === p ? 'selected' : '' %>><%= p %></option>
        <% }); %>
      </select>
    </label>
  </div>

  <label>
    Image filename (in /public/images/boats/)
    <input type="text" name="image_file" value="<%= boat ? boat.image_file : 'placeholder.svg' %>">
  </label>

  <label>
    Description
    <textarea name="description" required><%= boat ? boat.description : '' %></textarea>
  </label>

  <div class="actions-row">
    <a class="btn secondary" href="<%= boat ? '/boats/' + boat.id : '/sell' %>">Cancel</a>
    <button class="btn" type="submit"><%= boat ? 'Save changes' : 'List boat' %></button>
  </div>
</form>

<%- include('partials/footer') %>
