<%- include('partials/header') %>

<h1>Sell a Boat</h1>
<p>List your boat for buyers to find. It'll show up in the catalog right away.</p>

<form class="stacked-form" method="post" action="/sell">
  <label>
    Name
    <input type="text" name="name" required>
  </label>

  <div class="form-row">
    <label>
      Type
      <input type="text" name="type" required>
    </label>
    <label>
      Manufacturer
      <input type="text" name="manufacturer" required>
    </label>
  </div>

  <div class="form-row">
    <label>
      Year
      <input type="number" name="year" required>
    </label>
    <label>
      Length (ft)
      <input type="number" name="length_ft" required>
    </label>
    <label>
      Capacity
      <input type="number" name="capacity" required>
    </label>
  </div>

  <div class="form-row">
    <label>
      Price (USD)
      <input type="number" step="0.01" name="price" required>
    </label>
    <label>
      Stock
      <input type="number" name="stock" value="1" required>
    </label>
  </div>

  <label>
    Image filename (in /public/images/boats/)
    <input type="text" name="image_file" value="placeholder.svg">
  </label>

  <label>
    Description
    <textarea name="description" required></textarea>
  </label>

  <div class="actions-row">
    <a class="btn secondary" href="/">Cancel</a>
    <button class="btn" type="submit">List boat</button>
  </div>
</form>

<%- include('partials/footer') %>
