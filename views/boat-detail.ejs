<%- include('partials/header') %>

<p><a href="/">&larr; Back to catalog</a></p>

<div class="detail-page">
  <div class="gallery">
    <img id="mainImage" src="/images/boats/<%= gallery[0].file %>" alt="<%= boat.name %>">
    <% if (gallery.length > 1) { %>
      <div class="thumb-strip">
        <% gallery.forEach(function(img, i) { %>
          <img
            class="thumb <%= i === 0 ? 'active' : '' %>"
            src="/images/boats/<%= img.file %>"
            alt="<%= boat.name %> photo <%= i + 1 %>"
            data-full="/images/boats/<%= img.file %>"
            data-photographer="<%= img.photographer || '' %>"
            data-photographer-url="<%= img.photographer_url || '' %>"
            onclick="selectBoatImage(this)"
          >
        <% }); %>
      </div>
    <% } %>
    <p id="photoCredit" class="photo-credit">
      <% if (gallery[0].photographer) { %>
        Photo by <a href="<%= gallery[0].photographer_url %>" target="_blank" rel="noopener"><%= gallery[0].photographer %></a> on Pexels
      <% } %>
    </p>
  </div>
  <div>
    <h1><%= boat.name %></h1>
    <div class="price"><%= formatPrice(boat.price_cents) %></div>
    <ul class="spec-list">
      <li><strong>Type:</strong> <%= boat.type %></li>
      <li><strong>Manufacturer:</strong> <%= boat.manufacturer %></li>
      <li><strong>Year:</strong> <%= boat.year %></li>
      <li><strong>Length:</strong> <%= boat.length_ft %> ft</li>
      <li><strong>Capacity:</strong> <%= boat.capacity %> people</li>
      <li><strong>Stock:</strong> <%= boat.stock > 0 ? boat.stock + ' available' : 'Out of stock' %></li>
      <li><strong>Listed:</strong> <%= daysListed === 0 ? 'today' : daysListed + ' day' + (daysListed === 1 ? '' : 's') + ' ago' %></li>
      <li><strong>Views:</strong> <%= boat.views %></li>
    </ul>
    <p><%= boat.description %></p>

    <% if (boat.stock > 0) { %>
      <% if (currentUser) { %>
        <form method="post" action="/cart/add">
          <input type="hidden" name="boatId" value="<%= boat.id %>">
          <label>
            Quantity
            <input class="qty-input" type="number" name="quantity" value="1" min="1" max="<%= boat.stock %>">
          </label>
          <button class="btn" type="submit">Add to cart</button>
        </form>
      <% } else { %>
        <a class="btn" href="/login?next=<%= encodeURIComponent('/boats/' + boat.id) %>">Log in to add to cart</a>
      <% } %>
    <% } else { %>
      <button class="btn" disabled>Out of stock</button>
    <% } %>
  </div>
</div>

<% if (gallery.length > 1) { %>
<script>
  function selectBoatImage(el) {
    document.getElementById('mainImage').src = el.dataset.full;
    document.querySelectorAll('.thumb').forEach(function (t) { t.classList.remove('active'); });
    el.classList.add('active');

    var credit = document.getElementById('photoCredit');
    if (el.dataset.photographer) {
      credit.innerHTML = 'Photo by <a href="' + el.dataset.photographerUrl + '" target="_blank" rel="noopener">' + el.dataset.photographer + '</a> on Pexels';
    } else {
      credit.innerHTML = '';
    }
  }
</script>
<% } %>

<%- include('partials/footer') %>
