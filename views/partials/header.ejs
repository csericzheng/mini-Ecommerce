<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Mini Boat Shop' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="utility-bar">
    <a class="brand" href="/">⚓ Mini Boat Shop</a>
    <nav class="utility-nav">
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin">Admin</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/tests">Tests</a>
      <% } %>
      <% if (currentUser) { %>
        <a href="/sell">My Listings</a>
        <span class="utility-user">Hi, <%= currentUser.first_name %></span>
        <form method="post" action="/logout" class="inline-form">
          <button class="link-btn" type="submit">Log Out</button>
        </form>
      <% } else { %>
        <a href="/login">Log In</a>
        <a href="/register">Register</a>
      <% } %>
      <a href="/cart">Cart<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %></a>
    </nav>
  </div>
  <nav class="type-nav">
    <a href="/">All Boats</a>
    <% navTypes.forEach(function(t) { %>
      <a href="/?type=<%= encodeURIComponent(t) %>"><%= t %>s</a>
    <% }); %>
  </nav>
  <main>
