<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Mini Boat Shop' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="utility-bar">
    <a class="brand" href="/">⚓ Mini Boat Shop</a>
    <nav class="utility-nav">
      <a href="/admin">Sell a Boat</a>
      <a href="/cart">Cart<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %></a>
    </nav>
  </div>
  <nav class="type-nav">
    <a href="/">All Boats</a>
    <% navTypes.forEach(function(t) { %>
      <a href="/?type=<%= encodeURIComponent(t) %>"><%= t %>s</a>
    <% }); %>
  </nav>
