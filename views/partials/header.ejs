<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Mini Boat Shop' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="utility-bar">
    <a class="brand" href="/">⚓ Mini Boat Shop</a>
    <nav class="main-nav">
      <div class="nav-dropdown">
        <span class="nav-dropdown-toggle">Search ▾</span>
        <div class="nav-dropdown-menu">
          <a href="/">All Boats For Sale</a>
          <a href="/?sort=featured">Featured Listings</a>
          <a href="/?sort=new">Newly Listed Boats</a>
          <div class="nav-dropdown-divider"></div>
          <% navTypes.forEach(function(t) { %>
            <a href="/?type=<%= encodeURIComponent(t) %>"><%= t %>s</a>
          <% }); %>
        </div>
      </div>
      <a href="/?condition=used">Used Boats</a>
      <a href="/sell/new">Sell a Boat</a>
    </nav>
    <form class="nav-search" method="get" action="/">
      <input type="text" name="q" placeholder="Search Mini Boat Shop" value="<%= typeof q !== 'undefined' ? q : '' %>">
      <button type="submit" aria-label="Search"><span class="icon-search" aria-hidden="true"></span></button>
    </form>
    <nav class="utility-nav">
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin">Admin</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/tests">Tests</a>
      <% } %>
      <% if (currentUser) { %>
        <div class="nav-dropdown">
          <span class="nav-dropdown-toggle utility-user">👤 <%= currentUser.first_name %> ▾</span>
          <div class="nav-dropdown-menu nav-dropdown-menu-right">
            <a href="/sell">My Listings</a>
            <form method="post" action="/logout" class="nav-dropdown-form">
              <button class="link-btn" type="submit">Log Out</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a href="/login">Log In</a>
        <a href="/register">Register</a>
      <% } %>
      <a href="/cart">Cart<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %></a>
    </nav>
  </div>
  <main>
