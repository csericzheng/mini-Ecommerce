<%- include('partials/header') %>

<h1>Checkout</h1>

<table class="cart-table">
  <thead><tr><th>Boat</th><th>Price</th></tr></thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr>
        <td><%= item.name %></td>
        <td><%= formatPrice(item.price_cents) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<div class="cart-total">Total: <%= formatPrice(total_cents) %></div>

<div class="checkout-customer">
  <h2>Shipping To</h2>
  <p><%= currentUser.first_name %> <%= currentUser.last_name %></p>
  <p><%= currentUser.phone %></p>
  <% if (currentUser.email) { %><p><%= currentUser.email %></p><% } %>
</div>

<form method="post" action="/cart/checkout">
  <p style="color: var(--muted); font-size: 0.85rem;">This is a demo checkout — no real payment is processed.</p>
  <button class="btn" type="submit">Place order</button>
</form>

<%- include('partials/footer') %>
