<%- include('partials/header') %>

<h1>Process Your Purchase</h1>

<table class="cart-table">
  <thead><tr><th>Boat</th><th>Price</th></tr></thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr>
        <td><%= item.name %></td>
        <td><%= formatPrice(item.price_cents) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<div class="cart-total">Total: <%= formatPrice(total_cents) %></div>

<div class="checkout-customer">
  <h2>Shipping To</h2>
  <p><%= currentUser.first_name %> <%= currentUser.last_name %></p>
  <p><%= currentUser.phone %></p>
  <% if (currentUser.email) { %><p><%= currentUser.email %></p><% } %>
</div>

<form method="post" action="/cart/checkout">
  <p style="color: var(--muted); font-size: 0.85rem;">Your name, phone number, and the boat(s) above will be visible to our team to complete the sale. This is a demo — no real payment is processed.</p>
  <fieldset class="financing-question">
    <legend>Financing needed?</legend>
    <label class="radio-inline"><input type="radio" name="financingNeeded" value="yes"> Yes</label>
    <label class="radio-inline"><input type="radio" name="financingNeeded" value="no" checked> No</label>
  </fieldset>
  <button class="btn" type="submit">Process</button>
</form>

<%- include('partials/footer') %>
