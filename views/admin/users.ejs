<%- include('../partials/header') %>

<div class="page-heading">
  <h1>Admin: User Roles</h1>
  <a class="btn secondary" href="/admin">Back to boats</a>
</div>

<table class="admin-table">
  <thead>
    <tr><th>ID</th><th>Name</th><th>Phone</th><th>Email</th><th>Role</th><th></th></tr>
  </thead>
  <tbody>
    <% users.forEach(function(user) { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.first_name %> <%= user.last_name %></td>
        <td><%= user.phone %></td>
        <td><%= user.email || '' %></td>
        <td><%= user.role %></td>
        <td>
          <% if (user.id === currentUserId) { %>
            <em>(you)</em>
          <% } else { %>
            <form method="post" action="/admin/users/<%= user.id %>/role" style="display:inline">
              <select name="role">
                <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>user</option>
                <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>admin</option>
              </select>
              <button class="btn small" type="submit">Save</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('../partials/footer') %>
