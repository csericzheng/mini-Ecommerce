<%- include('../partials/header') %>

<h1><%= boat ? 'Edit Boat' : 'Add New Boat' %></h1>

<form class="stacked-form" method="post" action="<%= boat ? '/admin/' + boat.id + '/edit' : '/admin/new' %>">
  <label>
    Name
    <input type="text" name="name" value="<%= boat ? boat.name : '' %>" required>
  </label>

  <div class="form-row">
    <label>
      Type
      <input type="text" name="type" value="<%= boat ? boat.type : '' %>" required>
    </label>
    <label>
      Manufacturer
      <input type="text" name="manufacturer" value="<%= boat ? boat.manufacturer : '' %>" required>
    </label>
  </div>

  <div class="form-row">
    <label>
      Year
      <input type="number" name="year" value="<%= boat ? boat.year : '' %>" required>
    </label>
    <label>
      Length (ft)
      <input type="number" name="length_ft" value="<%= boat ? boat.length_ft : '' %>" required>
    </label>
    <label>
      Capacity
      <input type="number" name="capacity" value="<%= boat ? boat.capacity : '' %>" required>
    </label>
  </div>

  <div class="form-row">
    <label>
      Price (USD)
      <input type="number" step="0.01" name="price" value="<%= boat ? (boat.price_cents / 100).toFixed(2) : '' %>" required>
    </label>
    <label>
      Stock
      <input type="number" name="stock" value="<%= boat ? boat.stock : 0 %>" required>
    </label>
  </div>

  <label>
    Image filename (in /public/images/boats/)
    <input type="text" name="image_file" value="<%= boat ? boat.image_file : 'placeholder.svg' %>">
  </label>

  <label>
    Description
    <textarea name="description" required><%= boat ? boat.description : '' %></textarea>
  </label>

  <div class="actions-row">
    <a class="btn secondary" href="/admin">Cancel</a>
    <button class="btn" type="submit"><%= boat ? 'Save changes' : 'Create boat' %></button>
  </div>
</form>

<%- include('../partials/footer') %>
