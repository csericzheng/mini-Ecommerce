<%- include('../partials/header') %>

<div class="page-heading">
  <h1>Admin: Purchase Requests</h1>
  <a class="btn secondary" href="/admin">Back to boats</a>
</div>

<% if (orders.length === 0) { %>
  <p class="empty-state">No purchase requests yet.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr><th>Request</th><th>Buyer</th><th>Phone</th><th>Boats</th><th>Financing?</th><th>Total</th><th>Date</th></tr>
    </thead>
    <tbody>
      <% orders.forEach(function(order) { %>
        <tr>
          <td>#<%= order.id %></td>
          <td><%= order.customer_name %></td>
          <td><%= order.buyer_phone || '—' %></td>
          <td>
            <% order.items.forEach(function(item) { %>
              <div><a href="/boats/<%= item.boat_id %>">#<%= item.boat_id %> — <%= item.boat_name %></a></div>
            <% }); %>
          </td>
          <td><%= order.financing_needed ? 'Yes' : 'No' %></td>
          <td><%= formatPrice(order.total_cents) %></td>
          <td><%= order.created_at %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
